# Copy to .streamlit/secrets.toml locally (gitignored), or paste into Streamlit Cloud > App > Settings > Secrets.

# Shared password — anyone with the public URL must enter this. Same value as oncura-programs
# so the operator has one password across the suite.
APP_PASSWORD = "change-me"

# GitHub Contents API token (Contents:write on this repo) for persisting the access log.
# Without it, the app runs but the access log is session-only on Cloud.
GITHUB_TOKEN = "ghp_xxx"
